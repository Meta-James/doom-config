;;; $DOOMDIR/config.el -*- lexical-binding: t; -*-

;; Place your private configuration here! Remember, you do not need to run 'doom
;; sync' after modifying this file!

;; Doom's env cache (05-doom-env.load.el, regenerated by `doom sync --env')
;; loads unconditionally on every startup, before this file. If it was ever
;; regenerated from inside a Claude Code CLI subprocess shell (which any
;; agent's shell always is), it bakes in that shell's ephemeral,
;; subprocess-only Claude Code identity vars (CLAUDECODE, CLAUDE_JOB_DIR,
;; CLAUDE_CODE_SESSION_ID, etc.) as permanent config, so every `claude'
;; process later launched from Emacs (e.g. via claude-code-ide.el) inherits a
;; dead session's identity instead of a fresh one. Since this file is the one
;; thing Doom loads last, every startup, regardless of what's cached, strip
;; those vars here defensively rather than relying on the cache staying
;; clean. See docs/decisions.org ADR-013 and
;; docs/ai/troubleshooting.org::tshoot-claude-env-leak for the full incident.
(setq process-environment
      (seq-remove
       (lambda (entry) (string-match-p "\\`\\(CLAUDECODE\\|CLAUDE_[A-Z_]*\\|AI_AGENT\\)=" entry))
       process-environment))


;; Some functionality uses this to identify you, e.g. GPG configuration, email
;; clients, file templates and snippets. It is optional.
